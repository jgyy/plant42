@startuml project_structure

package "unityModule00" {
    package "Assets" {
        package "Scenes" {
            component "FloorIsLavaScene.unity"
        }

        package "Scripts" {
            component "PlayerController.cs"
            note right of "PlayerController.cs"
                Movement logic
                Jump logic
                Input handling
                Ground detection
                Game over checking
            end note
        }

        package "Materials" {
            component "Floor_Lava.mat"
            note right of "Floor_Lava.mat"
                Orange/Red color
                Emission shader
            end note

            component "Pathway_Stone.mat"
            note right of "Pathway_Stone.mat"
                Gray texture
                Stone look
            end note

            component "Player_Ball.mat"
            note right of "Player_Ball.mat"
                Colorful material
                Reflective shader
            end note

            component "Decoration_Materials"
        }

        package "Textures" {
            component "Lava_Texture"
            component "Stone_Texture"
            component "Vegetation_Textures"
            note right of "Vegetation_Textures"
                From Asset Store
            end note
        }

        package "Models" {
            component "Imported_Assets"
            note right of "Imported_Assets"
                From Unity Asset Store
                Trees, plants, etc.
            end note
        }

        package "Prefabs" {
            component "Pathway_Elements"
            component "Decorations"
        }

        package "Animations" {
            component "Optional_Animations"
        }
    }

    package "ProjectSettings" {
        component "ProjectVersion.txt"
        component "GraphicsSettings.asset"
        component "PhysicsSettings.asset"
        component "AudioManager.asset"
        component "QualitySettings.asset"
        component "EditorSettings.asset"
    }

    package "Packages" {
        component "manifest.json"
        component "Editor"
    }

    package "Other" {
        component ".gitignore"
        note right of ".gitignore"
            Auto-generated by Unity
            Exclude binary files
        end note

        component "README.md"
        component ".git"
    }
}

FloorIsLavaScene.unity --> PlayerController.cs
FloorIsLavaScene.unity --> Floor_Lava.mat
FloorIsLavaScene.unity --> Pathway_Stone.mat
FloorIsLavaScene.unity --> Player_Ball.mat

Lava_Texture --> Floor_Lava.mat
Stone_Texture --> Pathway_Stone.mat
Vegetation_Textures --> Decoration_Materials

Imported_Assets --> Decoration_Materials
Imported_Assets --> Vegetation_Textures

PlayerController.cs --> "FloorIsLavaScene.unity"

@enduml
